# cp .env.example .env

# API keys
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...
JINA_API_KEY=...

# Qdrant / retrieval
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=lab18_production
NAIVE_COLLECTION=lab18_naive

# Models
EMBEDDING_MODEL=jina-embeddings-v3
SEMANTIC_EMBEDDING_MODEL=jina-embeddings-v3
RERANK_MODEL=rerank-multilingual-v3.0
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
FLASHRANK_MAX_LENGTH=512
FLASHRANK_CACHE_DIR=
GENERATION_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=jina-embeddings-v3
RAGAS_EMBEDDING_PROVIDER=jina
JINA_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_USER_AGENT=lab18-production-rag/1.0
JINA_EMBEDDING_TYPE=float
JINA_NORMALIZED=1
JINA_TRUNCATE=1
JINA_BATCH_SIZE=32
JINA_TIMEOUT_SECONDS=30
JINA_MAX_RETRIES=5
JINA_BACKOFF_INITIAL_SECONDS=1.0
JINA_BACKOFF_MAX_SECONDS=16.0
JINA_TASK_RETRIEVAL_QUERY=retrieval.query
JINA_TASK_RETRIEVAL_PASSAGE=retrieval.passage
JINA_TASK_TEXT_MATCHING=text-matching

# Embedding / chunking
EMBEDDING_DIM=1024
JINA_DIMENSIONS=1024
HIERARCHICAL_PARENT_SIZE=2048
HIERARCHICAL_CHILD_SIZE=256
SEMANTIC_THRESHOLD=0.85

# Search / rerank
BM25_TOP_K=20
DENSE_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=3
DEFAULT_CONTEXT_TOP_K=3

# Evaluation / reports
PASS_THRESHOLD=0.75
FAILURE_BOTTOM_N=10
FAILURE_FAITHFULNESS_THRESHOLD=0.85
FAILURE_CONTEXT_RECALL_THRESHOLD=0.75
FAILURE_CONTEXT_PRECISION_THRESHOLD=0.75
FAILURE_ANSWER_RELEVANCY_THRESHOLD=0.80
REPORT_DIR=reports
RAGAS_REPORT_PATH=reports/ragas_report.json
NAIVE_REPORT_PATH=reports/naive_baseline_report.json

# Enrichment
DEFAULT_ENRICHMENT_METHODS=contextual,hyqa,metadata
ENRICHMENT_DEFAULT_QUESTIONS=3
ENRICHMENT_SUMMARY_MAX_CHARS=240
ENRICHMENT_SUMMARY_SHORT_MAX_CHARS=180

# hf token
HF_TOKEN=...
